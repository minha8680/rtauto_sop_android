<?xml version="1.0" encoding="utf-8"?>
<!-- 산업/관제 도구 느낌의 고딕 서체 — 기업용 안전 모니터링 앱 톤에 맞춰
     기본 Roboto 대신 IBM Plex Sans KR을 앱 전체 기본 서체로 쓴다. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/ibm_plex_sans_kr_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/ibm_plex_sans_kr_medium" />
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/ibm_plex_sans_kr_semibold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/ibm_plex_sans_kr_bold" />
</font-family>
