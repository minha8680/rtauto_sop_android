<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Rtauto_sop" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (사내 RT 로고 레드). -->
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryVariant">@color/brand_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorSecondaryVariant">@color/brand_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- 이 앱은 다크모드 스위치로 라이트/다크를 직접 관리하므로, OS의 자동 강제 다크
             렌더링(예: 삼성 OneUI "다른 앱에도 다크 모드 적용")은 꺼서 이중 적용을 막는다. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- 실행 시 잠깐 뜨는 스플래시 화면: 흰 배경 + 런처 아이콘과 같은 벨 마크. -->
    <style name="Theme.Rtauto_sop.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Rtauto_sop</item>
    </style>
</resources>
