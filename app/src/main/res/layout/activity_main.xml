<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ① 홈 -->
            <ScrollView
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 기기 등록 카드 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_key"
                                android:drawablePadding="8dp"
                                android:drawableTint="@color/brand_red"
                                android:gravity="center_vertical"
                                android:text="기기 등록"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="이 기기의 FCM 토큰을 엣지 PC 설정에 등록하세요"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                app:cardBackgroundColor="@color/card_bg"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/tokenText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="14dp"
                                    android:text="토큰을 가져오는 중..."
                                    android:textIsSelectable="true"
                                    android:fontFamily="monospace"
                                    android:textSize="12sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/copyButton"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:layout_gravity="end"
                                android:text="토큰 복사"
                                android:textColor="@color/brand_red"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_copy"
                                app:iconTint="@color/brand_red"
                                app:strokeColor="@color/brand_red" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 경보 테스트 카드 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_notification"
                                android:drawablePadding="8dp"
                                android:drawableTint="@color/brand_red"
                                android:gravity="center_vertical"
                                android:text="경보 테스트"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/testAlertButton"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="14dp"
                                android:backgroundTint="@color/brand_red"
                                android:text="테스트 경보 재생"
                                android:textAllCaps="false"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_notification"
                                app:iconTint="@color/white" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="20dp"
                                android:background="@color/outline" />

                            <TextView
                                android:id="@+id/volumeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="경보음 크기: 60%"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/volumeSlider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:stepSize="1"
                                android:valueFrom="0"
                                android:valueTo="10" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </ScrollView>

            <!-- ② 경보 상세 화면 (기획안 5.5절 그림4-②) -->
            <ScrollView
                android:id="@+id/alertDetailContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/alertLevelBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/level_critical"
                        android:drawableStart="@drawable/ic_nav_alert"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/white"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="18dp"
                        android:text="중대 편차 발생"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/outline"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <TextView
                                    android:id="@+id/alertTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2026.09.08. 화요일 09:10:18"
                                    android:textSize="13sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/alertTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="2인 1조 위반"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/alertBody"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="세정기 구역, 2인 1조 위반, 09시 10분 발생"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="15sp" />

                                <LinearLayout
                                    android:id="@+id/alertEmptyText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <ImageView
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:src="@drawable/ic_check_circle"
                                        android:contentDescription="@null"
                                        app:tint="@color/text_muted" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:text="현재 활성 경보가 없습니다."
                                        android:textSize="14sp"
                                        android:textColor="@color/text_muted" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/acknowledgeButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="54dp"
                                    android:layout_marginTop="24dp"
                                    android:backgroundTint="@color/level_critical"
                                    android:text="확인 (경보 종료)"
                                    android:textAllCaps="false"
                                    android:textSize="16sp"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_check_circle"
                                    app:iconTint="@color/white" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:gravity="center"
                                    android:text="확인을 누르면 경고음 · 진동이 즉시 멈춥니다."
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ③ 오늘 이벤트 목록 (기획안 5.5절 그림4-③) -->
            <ScrollView
                android:id="@+id/eventListContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_nav_list"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/brand_red"
                            android:gravity="center_vertical"
                            android:text="오늘 이벤트"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/eventListTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0건"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/eventListEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="48dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_check_circle"
                            android:contentDescription="@null"
                            app:tint="@color/text_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="오늘 발생한 이벤트가 없습니다."
                            android:textSize="14sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/eventListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical" />

                </LinearLayout>
            </ScrollView>

        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

    <!-- 인트로 스플래시 오버레이 — 흰 배경 위에 로고 · 문구가 서서히 나타난 뒤 사라진다. -->
    <LinearLayout
        android:id="@+id/introOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/white"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/introLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:src="@drawable/rt_logo_mark"
            android:contentDescription="@string/app_name" />

        <View
            android:id="@+id/introDivider"
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:alpha="0"
            android:background="@color/brand_red" />

        <TextView
            android:id="@+id/introTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:text="RT AUTOMATION"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.28" />

        <TextView
            android:id="@+id/introSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0"
            android:text="Co., Ltd."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.18" />

    </LinearLayout>

</FrameLayout>
