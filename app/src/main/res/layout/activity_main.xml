<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ① 홈 -->
            <ScrollView
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 기기 등록 카드 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:drawableStart="@drawable/ic_key"
                                    android:drawablePadding="8dp"
                                    android:drawableTint="@color/brand_red"
                                    android:gravity="center_vertical"
                                    android:text="기기 등록"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_success"
                                    android:drawableStart="@drawable/ic_check_circle"
                                    android:drawablePadding="4dp"
                                    android:drawableTint="@color/status_ok"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="발급됨"
                                    android:textColor="@color/status_ok"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="이 기기의 FCM 토큰을 엣지 PC 설정에 등록하세요"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                app:cardBackgroundColor="@color/card_bg"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/tokenText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="14dp"
                                    android:text="토큰을 가져오는 중..."
                                    android:textIsSelectable="true"
                                    android:fontFamily="@font/ibm_plex_mono"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/copyButton"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:layout_gravity="end"
                                android:text="토큰 복사"
                                android:textColor="@color/brand_red"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_copy"
                                app:iconTint="@color/brand_red"
                                app:strokeColor="@color/brand_red" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 경보 테스트 카드 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_notification"
                                android:drawablePadding="8dp"
                                android:drawableTint="@color/brand_red"
                                android:gravity="center_vertical"
                                android:text="경보 테스트"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/testAlertButton"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="14dp"
                                android:backgroundTint="@color/brand_red"
                                android:text="테스트 경보 재생"
                                android:textAllCaps="false"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_play"
                                app:iconTint="@color/white" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="20dp"
                                android:background="@color/outline" />

                            <TextView
                                android:id="@+id/volumeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="경보음 크기: 60%"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/volumeSlider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0dp"
                                android:stepSize="1"
                                android:valueFrom="0"
                                android:valueTo="10" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </ScrollView>

            <!-- ② 경보 상세 화면 (기획안 5.5절 그림4-②) -->
            <ScrollView
                android:id="@+id/alertDetailContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/alertLevelBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/critical_bg"
                        android:drawableStart="@drawable/ic_nav_alert"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp"
                        android:text="중대 편차 발생"
                        android:textColor="@color/critical_fg"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/alertDetailCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/outline"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <TextView
                                    android:id="@+id/alertTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ibm_plex_mono"
                                    android:text="2026.09.08. 화요일 09:10:18"
                                    android:textSize="12.5sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/alertTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="2인 1조 위반"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/alertBody"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="세정기 구역, 2인 1조 위반, 09시 10분 발생"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="15sp" />

                                <LinearLayout
                                    android:id="@+id/alertEmptyText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="12dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <FrameLayout
                                        android:layout_width="64dp"
                                        android:layout_height="64dp"
                                        android:background="@drawable/bg_icon_circle">

                                        <ImageView
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_check_circle"
                                            android:contentDescription="@null"
                                            app:tint="@color/status_ok" />
                                    </FrameLayout>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="14dp"
                                        android:text="현재 활성 경보가 없습니다."
                                        android:textSize="14sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:gravity="center"
                                        android:text="새로운 SOP 위반이 감지되면\n이 화면에 즉시 표시됩니다"
                                        android:textSize="13sp"
                                        android:textColor="@color/text_secondary" />

                                    <TextView
                                        android:id="@+id/autoResolvedSummary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="14dp"
                                        android:background="@drawable/bg_pill_success"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:paddingStart="14dp"
                                        android:paddingEnd="14dp"
                                        android:paddingTop="8dp"
                                        android:paddingBottom="8dp"
                                        android:textSize="12sp"
                                        android:textColor="@color/status_ok"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/acknowledgeButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="54dp"
                                    android:layout_marginTop="24dp"
                                    android:backgroundTint="@color/brand_red"
                                    android:text="확인 (경보 종료)"
                                    android:textAllCaps="false"
                                    android:textSize="16sp"
                                    app:cornerRadius="12dp"
                                    app:icon="@drawable/ic_check"
                                    app:iconTint="@color/white" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:gravity="center"
                                    android:text="확인을 누르면 경고음 · 진동이 즉시 멈춥니다."
                                    android:textColor="@color/text_muted"
                                    android:textSize="12sp" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- 지금 카드 위 알림은 최신 위반 1건뿐이고, 그사이 다른 위반이 확정돼도
                             조용히 이 카드로 대체된다 — 놓치지 않도록 "다른 활성 위반 N건"을
                             눌러서 펼쳐볼 수 있게 한다(2026-09-16, 실사용 중 발견). -->
                        <LinearLayout
                            android:id="@+id/otherAlertsToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/otherAlertsToggleText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="다른 활성 위반 1건"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/otherAlertsChevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_chevron_right"
                                android:contentDescription="@null"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/otherAlertsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ③ 오늘 이벤트 목록 (기획안 5.5절 그림4-③) -->
            <ScrollView
                android:id="@+id/eventListContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 날짜 선택 캘린더 — 시안(캔버스)의 커스텀 월 그리드를 그대로 옮겼다.
                         날짜를 누르면 그날 이력만 아래에 나온다. 양옆 화살표로 한 달씩
                         넘기거나, 가운데 월 라벨을 눌러 연도·월을 한번에 빠르게 고를 수
                         있는 선택기(MaterialDatePicker, 연도 그리드 내장)를 띄운다. -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:paddingBottom="12dp">

                                <ImageButton
                                    android:id="@+id/calendarPrevMonth"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="이전 달"
                                    android:src="@drawable/ic_chevron_left"
                                    app:tint="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/calendarMonthLabel"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="?attr/selectableItemBackground"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:paddingVertical="6dp"
                                    android:text="2026년 9월"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <ImageButton
                                    android:id="@+id/calendarNextMonth"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="다음 달"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/text_secondary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    style="@style/CalendarWeekdayLabel"
                                    android:text="일"
                                    android:textColor="@color/critical_fg" />

                                <TextView style="@style/CalendarWeekdayLabel" android:text="월" />
                                <TextView style="@style/CalendarWeekdayLabel" android:text="화" />
                                <TextView style="@style/CalendarWeekdayLabel" android:text="수" />
                                <TextView style="@style/CalendarWeekdayLabel" android:text="목" />
                                <TextView style="@style/CalendarWeekdayLabel" android:text="금" />

                                <TextView
                                    style="@style/CalendarWeekdayLabel"
                                    android:text="토"
                                    android:textColor="@color/normal_fg" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/calendarGrid"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/eventListDateTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_nav_list"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/brand_red"
                            android:gravity="center_vertical"
                            android:text="오늘 이벤트"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/eventListTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0건"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/eventListEmptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_check_circle"
                            android:contentDescription="@null"
                            app:tint="@color/text_muted" />

                        <TextView
                            android:id="@+id/eventListEmptyLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="선택한 날짜에 이벤트가 없습니다."
                            android:textSize="14sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/eventListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical" />

                </LinearLayout>
            </ScrollView>

            <!-- ④ 설정 -->
            <ScrollView
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <!-- 경보 -->
                    <TextView style="@style/SettingsSectionLabel" android:text="경보" />

                    <LinearLayout
                        android:id="@+id/soundPickerRow"
                        style="@style/SettingsRow"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_notification"
                            android:contentDescription="@null"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="경보음 선택" />

                        <TextView
                            android:id="@+id/soundNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="시스템 기본 알람음"
                            android:textColor="@color/text_muted"
                            android:textSize="12.5sp" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null"
                            app:tint="@color/text_muted" />
                    </LinearLayout>

                    <View style="@style/SettingsRowDivider" />

                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_mic"
                            android:contentDescription="@null"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="음성 안내 (TTS)" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/ttsSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/SettingsRowDivider" />

                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_vibration"
                            android:contentDescription="@null"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="진동" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/vibrationSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- 데이터 -->
                    <TextView style="@style/SettingsSectionLabel" android:text="데이터" />

                    <LinearLayout
                        android:id="@+id/clearHistoryButton"
                        style="@style/SettingsRow"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_delete"
                            android:contentDescription="@null"
                            app:tint="@color/critical_fg" />

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="오늘 이벤트 전체 삭제"
                            android:textColor="@color/critical_fg" />
                    </LinearLayout>

                    <!-- 정보 -->
                    <TextView style="@style/SettingsSectionLabel" android:text="정보" />

                    <LinearLayout style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_check_circle"
                            android:contentDescription="@null"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="앱 버전" />

                        <TextView
                            android:id="@+id/appVersionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ibm_plex_mono"
                            android:text="RT SOP 알림 v1.0"
                            android:textColor="@color/text_muted"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <View style="@style/SettingsRowDivider" />

                    <LinearLayout
                        android:id="@+id/openNotificationSettingsButton"
                        style="@style/SettingsRow"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_notification"
                            android:contentDescription="@null"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/SettingsRowLabel"
                            android:text="알림 설정 바로가기" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null"
                            app:tint="@color/text_muted" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/bottom_nav_menu" />

    </LinearLayout>

    <!-- 인트로 스플래시 오버레이 — 흰 배경 위에 로고 · 문구가 서서히 나타난 뒤 사라진다. -->
    <LinearLayout
        android:id="@+id/introOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/white"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/introLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:src="@drawable/rt_logo_mark"
            android:contentDescription="@string/app_name" />

        <View
            android:id="@+id/introDivider"
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:alpha="0"
            android:background="@color/brand_red" />

        <TextView
            android:id="@+id/introTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:text="RT AUTOMATION"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.28" />

        <TextView
            android:id="@+id/introSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0"
            android:text="Co., Ltd."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.18" />

    </LinearLayout>

</FrameLayout>
