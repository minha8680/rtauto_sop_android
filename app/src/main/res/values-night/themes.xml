<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (다크모드). -->
    <style name="Theme.Rtauto_sop" parent="Theme.MaterialComponents.DayNight">
        <!-- Primary brand color (사내 RT 로고 레드) — 다크 배경에서도 그대로 유지한다. -->
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryVariant">@color/brand_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorSecondaryVariant">@color/brand_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="fontFamily">@font/ibm_plex_sans_kr</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="actionBarStyle">@style/Widget.Rtauto.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
